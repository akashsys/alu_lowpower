# FAST SYNTHESIS MODE (For initial testing, no aggressive optimization)
# Use this if syn_script.ys times out

# 1. Read the Speculative RTL
read_verilog elastic_credit_arbiter.v

# 2. Preparation & Optimization
hierarchy -check -top elastic_credit_arbiter
proc; 
opt; 
fsm; 
opt; 
memory; 
opt

# 3. High-Speed Synthesis Pass
synth -top elastic_credit_arbiter

# 4. Map to Flip-Flops
dfflibmap -liberty sky130_fd_sc_hd__tt_025C_1v80.lib

# 5. Basic Logic Mapping (NO TIMING OPTIMIZATION - Fast but may not meet timing)
# This will complete quickly but produce larger/slower results
abc -liberty sky130_fd_sc_hd__tt_025C_1v80.lib

# 6. Convert 'assign' statements to physical buffers
insbuf -buf sky130_fd_sc_hd__buf_2 A X

# 7. Final Netlist Cleanup
setundef -zero
splitnets -ports
opt_clean -purge

# 8. Write the Netlist
write_verilog -noattr netlist.v

# 9. Print Statistics
stat -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
