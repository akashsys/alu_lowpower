library(demo) {
  delay_model : table_lookup;
  in_place_swap_mode : match_smallest;
  time_unit : "1ns";
  capacitive_load_unit (1,pf);

  /* Buffers & Inverters */
  cell(BUF) {
    area: 1;
    pin(A) { direction: input; }
    pin(Y) { direction: output; function: "A"; }
  }
  cell(IV) {
    area: 1;
    pin(A) { direction: input; }
    pin(Y) { direction: output; function: "A'"; }
  }

  /* Standard 2-Input Logic */
  cell(AN2) {
    area: 2;
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(Y) { direction: output; function: "(A*B)"; }
  }
  cell(OR2) {
    area: 2;
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(Y) { direction: output; function: "(A+B)"; }
  }
  cell(ND2) {
    area: 2;
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(Y) { direction: output; function: "(A*B)'"; }
  }
  cell(NR2) {
    area: 2;
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(Y) { direction: output; function: "(A+B)'"; }
  }
  cell(XR2) {
    area: 3;
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(Y) { direction: output; function: "(A^B)"; }
  }

  /* 3-Input Logic */
  cell(ND3) {
    area: 3;
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(C) { direction: input; }
    pin(Y) { direction: output; function: "(A*B*C)'"; }
  }

  /* Multiplexer */
  cell(MUX2) {
    area: 4;
    pin(A) { direction: input; }
    pin(B) { direction: input; }
    pin(S) { direction: input; }
    pin(Y) { direction: output; function: "((A*S')+(B*S))"; }
  }

  /* Sequential Cells */

  /* D-Flip-Flop with Asynchronous Reset (NEW) */
  cell(DFFR) {
    area: 14;
    ff("IQ", "IQN") { 
      clocked_on: "CLK"; 
      next_state: "D"; 
      clear: "!RST_N"; 
    }
    pin(CLK) { direction: input; clock: true; }
    pin(RST_N) { direction: input; }
    pin(D) { direction: input; }
    pin(Q) { direction: output; function: "IQ"; }
  }

  /* Basic D-Flip-Flop */
  cell(DFF) {
    area: 10;
    ff("IQ", "IQN") { clocked_on: "CLK"; next_state: "D"; }
    pin(CLK) { direction: input; clock: true; }
    pin(D) { direction: input; }
    pin(Q) { direction: output; function: "IQ"; }
  }

  /* D-Flip-Flop with Clock Enable */
  cell(DFFE) {
    area: 12;
    ff("IQ", "IQN") { clocked_on: "CLK"; next_state: "((D*EN)+(IQ*EN'))"; }
    pin(CLK) { direction: input; clock: true; }
    pin(EN) { direction: input; }
    pin(D) { direction: input; }
    pin(Q) { direction: output; function: "IQ"; }
  }
}